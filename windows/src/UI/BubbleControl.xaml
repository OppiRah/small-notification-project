<UserControl x:Class="NotificationBridge.Windows.UI.BubbleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- The side/vertical margins leave room for the drop shadow, which would otherwise be clipped
         by the transparent overlay window's edges. -->
    <Border x:Name="Card" Margin="12,6" CornerRadius="12" Padding="14,10"
            Background="#F22B2B2E" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270"
                              Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="IconImage" Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0"
                   VerticalAlignment="Top" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeaderText" FontWeight="SemiBold" Foreground="#99FFFFFF" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="White" FontSize="14"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="BodyText" Foreground="#CCFFFFFF" FontSize="12.5" Margin="0,4,0,0"
                           TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
