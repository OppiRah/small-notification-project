<UserControl x:Class="NotificationBridge.Windows.UI.BubbleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Margin="0,0,0,10">
    <Border CornerRadius="10" Background="#F22B2B2E" Padding="14,10">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontWeight="Bold" Foreground="White" FontSize="13"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="BodyText" Foreground="#DDFFFFFF" FontSize="12" Margin="0,4,0,0"
                       TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</UserControl>
