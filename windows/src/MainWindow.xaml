<Window x:Class="NotificationBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification Bridge" Height="580" Width="740">
    <DockPanel Margin="10">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"/>

        <TabControl>
            <TabItem Header="Settings">
                <StackPanel Margin="10">
                    <GroupBox Header="Pairing" Margin="0,0,0,10">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="PairButton" Content="Pair new device" Padding="8,4"
                                        Margin="0,0,8,0" Click="PairButton_Click"/>
                                <TextBlock x:Name="PairingStatusText" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Trusted devices:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="TrustedDevicesCombo" Width="260" Margin="0,0,8,0"/>
                                <Button x:Name="UnpairButton" Content="Unpair selected" Padding="8,4"
                                        Click="UnpairButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Display" Margin="0,0,0,10">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Monitor:" Width="130" VerticalAlignment="Center"/>
                                <ComboBox x:Name="MonitorCombo" Width="220"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Corner:" Width="130" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CornerCombo" Width="220">
                                    <ComboBoxItem Content="Top Left"/>
                                    <ComboBoxItem Content="Top Right"/>
                                    <ComboBoxItem Content="Bottom Left"/>
                                    <ComboBoxItem Content="Bottom Right"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Bubble duration:" Width="130" VerticalAlignment="Center"/>
                                <Slider x:Name="DurationSlider" Width="180" Minimum="2" Maximum="30"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="DurationSlider_ValueChanged"/>
                                <TextBlock x:Name="DurationValueText" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Max visible bubbles:" Width="130" VerticalAlignment="Center"/>
                                <Slider x:Name="MaxBubblesSlider" Width="180" Minimum="1" Maximum="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="MaxBubblesSlider_ValueChanged"/>
                                <TextBlock x:Name="MaxBubblesValueText" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AnimationCheckBox" Content="Enable fade animation" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="StartupCheckBox" Content="Start with Windows" Margin="0,0,0,10"/>

                    <Button x:Name="ApplySettingsButton" Content="Apply settings" Padding="10,6"
                            HorizontalAlignment="Left" Click="ApplySettingsButton_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Developer">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="SendValidButton" Content="Send valid test notification"
                                Padding="8,4" Margin="0,0,8,0" Click="SendValidButton_Click"/>
                        <Button x:Name="SendMalformedButton" Content="Send malformed test message"
                                Padding="8,4" Click="SendMalformedButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
